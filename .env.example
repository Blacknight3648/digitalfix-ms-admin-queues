# Configuración del Microservicio Administrador de Colas y Tópicos
PORT=8084

# Configuración de Conexión a RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_VIRTUAL_HOST=/

# Configuración de Conexión a Apache Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_DEFAULT_REPLICAS=1
KAFKA_EXTERNAL_PORT=29092

# Recursos protegidos (no eliminables vía API)
ADMIN_PROTECTED_RESOURCES=q.cmd.*,cmd.*,workorders.events*,audit.timeline
